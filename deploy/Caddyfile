:80 {
	root * /srv
	encode zstd gzip

	# Serve favicon.ico cleanly from /assets/favicon.png
	rewrite /favicon.ico /assets/favicon.png

	# Redirect bare /en to /en/ so relative paths stay canonical
	redir /en /en/ 308

	# Force Android APK MIME type and attachment header
	@apk path /download/*.apk
	header @apk {
		Content-Type "application/vnd.android.package-archive"
		Content-Disposition "attachment"
		Cache-Control "public, max-age=3600"
	}

	@assets path /assets/*
	header @assets {
		Cache-Control "public, max-age=86400"
	}

	@html {
		not path /assets/* /download/*
	}
	header @html {
		Cache-Control "no-cache"
	}

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
